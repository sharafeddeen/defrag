{
  "$schema": "https://schema.hypermode.com/modus.json",
  "endpoints": {
    "default": {
      "type": "graphql",
      "path": "/graphql",
      "auth": "bearer-token"
    },
    "message": {
      "type": "graphql",
      "path": "/message",
      "auth": "none"
    }
  },
  "models": {
    "text-generator": {
      "sourceModel": "meta-llama/Meta-Llama-3.1-8B-Instruct",
      "provider": "hugging-face",
      "connection": "hypermode"
    },
    "minilm": {
      "sourceModel": "sentence-transformers/all-MiniLM-L6-v2",
      "provider": "hugging-face",
      "connection": "hypermode"
    }
  },
  "connections": {
    "neo4j": {
      "type": "neo4j",
      "dbUri": "neo4j+s://f763e0c7.databases.neo4j.io",
      "username": "{{USERNAME}}",
      "password": "{{PASSWORD}}"
    }
  }
}
